# --- Runtime backend ---
# "cli" = headless `claude` (your subscription); "api" = Anthropic API (parallel automation).
CONVEER_PROVIDER=cli
# Required for provider=api (and usable by the CLI too).
ANTHROPIC_API_KEY=
CONVEER_API_MAX_TOKENS=4096

# --- Factory validation loop (validator -> targeted fix -> re-validate) ---
CONVEER_FACTORY_BAR=0.75
CONVEER_FACTORY_MAX_FIX=2

# --- Triad: bind each of the 3 Claudes to its own auth (one per role) ---
# API mode: give each role its own key.
#   CONVEER_PROVIDER_ORCHESTRATOR=api
#   CONVEER_KEY_ORCHESTRATOR=sk-ant-...
#   CONVEER_PROVIDER_WORKER=api
#   CONVEER_KEY_WORKER=sk-ant-...
#   CONVEER_PROVIDER_CRITIC=api
#   CONVEER_KEY_CRITIC=sk-ant-...
# CLI mode: give each role its own logged-in Claude Code account dir.
#   CONVEER_CLAUDE_DIR_ORCHESTRATOR=~/.claude-orchestrator
#   CONVEER_CLAUDE_DIR_WORKER=~/.claude-worker
#   CONVEER_CLAUDE_DIR_CRITIC=~/.claude-critic
#
# Mixed: Claude manages + validates, a free Qwen does the work (OpenAI-compatible).
# Orchestrator + Validator stay on Claude; Worker runs on Qwen via OpenRouter:
#   CONVEER_PROVIDER_WORKER=openai
#   CONVEER_BASEURL_WORKER=https://openrouter.ai/api/v1
#   CONVEER_KEY_WORKER=sk-or-...                       # OpenRouter key
#   CONVEER_MODEL_WORKER=qwen/qwen-2.5-72b-instruct    # or a :free variant
# (Local Qwen via Ollama instead: BASEURL=http://localhost:11434/v1, KEY=ollama,
#  MODEL=qwen2.5)

# Model ids per role tier (override defaults from config.py if needed)
CONVEER_MODEL_LEAD=claude-opus-4-8        # CEO / Analyst (reasoning-heavy)
CONVEER_MODEL_WORKER=claude-sonnet-4-6    # Idea Generator / Reporter (cheaper)

# --- LangSmith observability (optional but recommended) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=startup-conveer

# --- runtime tuning ---
CONVEER_SUBORDINATE_TIMEOUT=300           # seconds per `claude -p` call
